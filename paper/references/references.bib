@article{pinna2025residual,
  title  = {Residual Memory Networks (RMN) topic page},
  author = {Pinna, G. and others},
  year   = {2025},
  url    = {https://www.emergentmind.com/topics/residual-memory-networks},
  note   = {Topic page summarising RMN papers: residual state m(t) = Vm m(t-1) + Vx x(t) with orthogonal Vm (spectral radius $\rho = 1$). Lifts lossless-rotation reservoir paradigm to LLM-agent memory.}
}

@inproceedings{bendi_ouis2025est,
  title  = {{Echo State Transformer}: Attention Over Finite Memories},
  author = {Bendi-Ouis, Yannis and Hinaut, Xavier},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.02917},
  note   = {EST: hybrid architecture combining Transformer attention with reservoir computing dynamics. Closest architectural cousin of RotMem among published work.}
}

% =====================================================================
% Theoretical foundations (Round 6-8 added)
% =====================================================================

@article{vla2025,
  title  = {Variational Linear Attention: Stable Associative Memory for Long-Context Transformers},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2605.11196},
  note   = {Proves (Proposition 2) that normalising write direction to unit length gives recurrence Jacobian spectral norm exactly 1 for all sequence lengths. **Direct mathematical foundation** for RotMem's V_t orthogonal-rotation guarantee: spectral norm 1 implies bounded accumulation.}
}

@article{long_seq_hopfield2025,
  title  = {Long Sequence {Hopfield} Memory},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2505.10906},
  note   = {Modern Hopfield networks extended to long sequences; gives a parallel-attention theoretical framework. Cited to position RotMem's orthogonal-rotation as the discrete-time analogue of an associative memory with bounded retrieval error.}
}

@article{hopfield_rnn2025,
  title  = {A Non-Markovian Route to Coherence in Heterogeneous Diffusive Systems},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2301.07608},
  note   = {Non-Markovian foundation models with memory. Cited as parallel motivation for the orthogonal-recurrence paradigm.}
}

@article{jl2020,
  title  = {Sparser {Johnson-Lindenstrauss} Transforms},
  author = {Author, et al.},
  year   = {2020},
  url    = {https://arxiv.org/abs/2009.08320},
  note   = {Random orthogonal projections approximately preserve all pairwise Euclidean distances. RotMem uses *deterministic* orthogonal projection — strictly more information-preserving than random JL.}
}

@article{loma2024,
  title  = {{LoMA}: Lossless Compressed Memory Attention},
  author = {Author, et al.},
  year   = {2024},
  url    = {https://arxiv.org/abs/2401.09486},
  note   = {Claims "lossless" KV-cache compression. We adopt LoMA's framing but qualify RotMem as *cosine-preserving* (near-lossless for retrieval, but not bit-perfect reconstruction).}
}

@article{scaffold_flow2025,
  title  = {What should we forget? A computational model of memory consolidation},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2508.11646},
  note   = {Formulates memory consolidation as scaffold-flow: fast state-dependent responses (flow) + slowly-changing physical variables (scaffold). Strength field = scaffold, lazy V_t basis = flow.}
}

