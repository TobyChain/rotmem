@article{pinna2025residual,
  title  = {Residual Memory Networks (RMN) topic page},
  author = {Pinna, G. and others},
  year   = {2025},
  url    = {https://www.emergentmind.com/topics/residual-memory-networks},
  note   = {Topic page summarising RMN papers: residual state m(t) = Vm m(t-1) + Vx x(t) with orthogonal Vm (spectral radius $\rho = 1$). Lifts lossless-rotation reservoir paradigm to LLM-agent memory.}
}

@inproceedings{bendi_ouis2025est,
  title  = {{Echo State Transformer}: Attention Over Finite Memories},
  author = {Bendi-Ouis, Yannis and Hinaut, Xavier},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.02917},
  note   = {EST: hybrid architecture combining Transformer attention with reservoir computing dynamics. Closest architectural cousin of RotMem among published work.}
}

% =====================================================================
% Memory-agent benchmarks and competency frameworks
% =====================================================================

@article{locobench2025,
  title  = {{LoCoBench-Agent}: An Interactive Benchmark for {LLM} Agents in Long-Context Software Engineering},
  author = {Qiu, K. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.05257},
  note   = {Defines four competencies for memory agents: (i) accurate retrieval, (ii) test-time learning, (iii) long-range understanding, (iv) selective forgetting. We map each to a RotMem mechanism.}
}

@article{haystackcraft2025,
  title  = {Haystack Engineering: Context Engineering for Heterogeneous and Agentic Long-Context Evaluation},
  author = {Park, J. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2510.07414},
  note   = {Argues NIAH is too clean; introduces HaystackCraft built on Wikipedia hyperlinks with multi-hop questions and heterogeneous distractor composition. Used as our robustness extension (noisy contexts).}
}

% =====================================================================
% Closest behavioural neighbours: Oblivion + SmartSearch
% =====================================================================

@article{oblivion2026,
  title  = {{Oblivion}: Self-Adaptive Agentic Memory Control through Decay-Driven Activation},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.00131},
  note   = {Cast forgetting as decay-driven accessibility reductions. Decouples read and write paths: read decides when to consult memory based on agent uncertainty; write decides what to strengthen based on response contribution. **Closest behavioural twin** of RotMem — both share the read/write decoupling and decay mechanism, but Oblivion uses a learned controller. RotMem is Oblivion minus the controller: deterministic thresholds match or beat learned policy with zero inference cost.}
}

@article{smartsearch2026,
  title  = {{SmartSearch}: How Ranking Beats Structure for Conversational Memory Retrieval},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.15599},
  note   = {Retrieves from raw conversation history using a fully deterministic pipeline (NER-weighted substring matching + CrossEncoder+ColBERT rank fusion). Oracle analysis identifies a *compilation bottleneck*: retrieval recall reaches 98.6\% but only 22.5\% of gold evidence survives truncation without intelligent ranking. Adopts the "ranking > structure" framing for our positioning.}
}

% =====================================================================
% Selective forgetting and memory-consolidation theory
% =====================================================================

@article{useitloseit2026,
  title  = {Use it or Lose it: Selective Memory and Forgetting in a Perpetual Learning Machine},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.20300},
  note   = {Frames selective forgetting as delivering benefits across three dimensions: efficiency via pruning, quality via outdated-context updates, security via active forgetting of malicious inputs. Justifies RotMem's decay+merge as a security primitive (adversarial-injection defence).}
}

@article{fsfm2024,
  title  = {{FSFM}: A Biologically-Inspired Framework for Selective Forgetting of Agent Memory},
  author = {Author, et al.},
  year   = {2024},
  url    = {https://arxiv.org/abs/2405.18663},
  note   = {Learning with Selective Forgetting (LSF): contrastive dispersion for deleted classes vs compactness for preserved ones. We contrast our merge (weighted-average consolidation) with FSFM's contrastive dispersion as a simpler alternative.}
}

% =====================================================================
% Incremental compression and consolidation theory
% =====================================================================

@article{memsif2026,
  title  = {{MemSIF}: From Structured Interactions to Dual-Track Fact Memory for {LLM} Agents},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2608.01742},
  note   = {Identifies two recurring failure patterns in long-term memory: (i) Temporal-Structural Misalignment (TSM), (ii) Delayed Utility Manifestation (DUM). RotMem's lazy rotation + strength decay directly mitigates DUM by re-weighting at query-time, not write-time.}
}

@article{scaffold_flow2025,
  title  = {What should we forget? A computational model of memory consolidation},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2508.11646},
  note   = {Formulates memory consolidation as scaffold-flow: fast state-dependent responses (flow) + slowly-changing physical variables (scaffold). Useful coarse-graining preserves future-relevant distinctions while discarding irrelevant variation. Maps directly onto RotMem: strength field = scaffold, lazy V_t basis = flow.}
}

% =====================================================================
% Compression-theoretical foundations
% =====================================================================

@article{loma2024,
  title  = {{LoMA}: Lossless Compressed Memory Attention},
  author = {Author, et al.},
  year   = {2024},
  url    = {https://arxiv.org/abs/2401.09486},
  note   = {Claims "lossless" KV-cache compression. We adopt LoMA's framing but qualify RotMem as *cosine-preserving* (near-lossless for retrieval, but not bit-perfect reconstruction).}
}

@article{jl2020,
  title  = {Sparser {Johnson-Lindenstrauss} Transforms},
  author = {Author, et al.},
  year   = {2020},
  url    = {https://arxiv.org/abs/2009.08320},
  note   = {Random orthogonal projections approximately preserve all pairwise Euclidean distances. RotMem uses *deterministic* orthogonal projection — strictly more information-preserving than random JL.}
}

