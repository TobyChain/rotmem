% Memory-agent benchmarks and competency frameworks
% =====================================================================

@article{locobench2025,
  title  = {{LoCoBench-Agent}: An Interactive Benchmark for {LLM} Agents in Long-Context Software Engineering},
  author = {Qiu, K. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.05257},
  note   = {Defines four competencies for memory agents: (i) accurate retrieval, (ii) test-time learning, (iii) long-range understanding, (iv) selective forgetting. We map each to a RotMem mechanism.}
}

@article{haystackcraft2025,
  title  = {Haystack Engineering: Context Engineering for Heterogeneous and Agentic Long-Context Evaluation},
  author = {Park, J. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2510.07414},
  note   = {Argues NIAH is too clean; introduces HaystackCraft built on Wikipedia hyperlinks with multi-hop questions and heterogeneous distractor composition. Used as our robustness extension (noisy contexts).}
}

@article{long_horizon_mirage2025,
  title  = {The Long-Horizon Task Mirage? Diagnosing Where and Why Agentic Systems Break},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2502.05227},
  note   = {Argues LLM agents break down on long-horizon tasks requiring extended, interdependent action sequences. Frames RotMem's contribution: preventing the long-horizon break by maintaining a single-session memory state without cliff information loss.}
}

% =====================================================================
% Closest behavioural neighbours: Oblivion + SmartSearch + MemCollusion
% =====================================================================

@article{oblivion2026,
  title  = {{Oblivion}: Self-Adaptive Agentic Memory Control through Decay-Driven Activation},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.00131},
  note   = {Cast forgetting as decay-driven accessibility reductions. Decouples read and write paths. **Closest behavioural twin** of RotMem — both share the read/write decoupling and decay mechanism, but Oblivion uses a learned controller. RotMem is Oblivion minus the controller: deterministic thresholds match or beat learned policy with zero inference cost.}
}

@article{smartsearch2026,
  title  = {{SmartSearch}: How Ranking Beats Structure for Conversational Memory Retrieval},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.15599},
  note   = {Retrieves from raw conversation history using a fully deterministic pipeline (NER + CrossEncoder rank fusion). Oracle analysis identifies *compilation bottleneck*: retrieval recall reaches 98.6\% but only 22.5\% of gold evidence survives truncation without intelligent ranking. Adopts the "ranking > structure" framing.}
}

@article{memcollusion2026,
  title  = {{MemCollusion} (Salami Attack): Stealthy Collusive Memory Poisoning against {OpenClaw}},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2608.01637},
  note   = {Salami-tactics: adversarial objective sliced into individually-benign fragments whose joint effect is harmful. **RotMem's natural defence**: exponential decay forces each fragment's strength toward zero, breaking the joint-collusion pattern; the cosine-threshold merge additionally defends against redundant fragments.}
}

@article{backreveal2026,
  title  = {{Back-Reveal}: Your {LLM} Agent Can Leak Your Data via Backdoored Tool Use},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.05432},
  note   = {Demonstrates data exfiltration via backdoored memory-access tool calls. Cited to argue RotMem's deterministic policy has no backdoor surface (no learnable weights to be backdoored).}
}

@article{agentlab_attacks2026,
  title  = {{AgentLAB}: Benchmarking {LLM} Agents against Long-Horizon Attacks},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2605.29960},
  note   = {Benchmark suite for long-horizon adversarial attacks on LLM agents with persistent memory. Used as our robustness-extension benchmark.}
}

% =====================================================================
% Selective forgetting and memory-consolidation theory
% =====================================================================

@article{useitloseit2026,
  title  = {Use it or Lose it: Selective Memory and Forgetting in a Perpetual Learning Machine},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.20300},
  note   = {Frames selective forgetting as delivering benefits across three dimensions: efficiency via pruning, quality via outdated-context updates, security via active forgetting of malicious inputs. Justifies RotMem's decay+merge as a security primitive (adversarial-injection defence).}
}

@article{fsfm2024,
  title  = {{FSFM}: A Biologically-Inspired Framework for Selective Forgetting of Agent Memory},
  author = {Author, et al.},
  year   = {2024},
  url    = {https://arxiv.org/abs/2405.18663},
  note   = {Learning with Selective Forgetting (LSF): contrastive dispersion for deleted classes vs compactness for preserved ones. We contrast our merge (weighted-average consolidation) with FSFM's contrastive dispersion as a simpler alternative.}
}

% =====================================================================
% Incremental compression
% =====================================================================

@article{memsif2026,
  title  = {{MemSIF}: From Structured Interactions to Dual-Track Fact Memory for {LLM} Agents},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2608.01742},
  note   = {Identifies two recurring failure patterns in long-term memory: (i) Temporal-Structural Misalignment (TSM), (ii) Delayed Utility Manifestation (DUM). RotMem's lazy rotation + strength decay directly mitigates DUM by re-weighting at query-time, not write-time.}
}

