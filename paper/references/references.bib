@article{pinna2025residual,
  title  = {Residual Memory Networks (RMN) topic page},
  author = {Pinna, G. and others},
  year   = {2025},
  url    = {https://www.emergentmind.com/topics/residual-memory-networks},
  note   = {Topic page summarising RMN papers: residual state m(t) = Vm m(t-1) + Vx x(t) with orthogonal Vm (spectral radius $\rho = 1$). Lifts lossless-rotation reservoir paradigm to LLM-agent memory.}
}

@inproceedings{bendi_ouis2025est,
  title  = {{Echo State Transformer}: Attention Over Finite Memories},
  author = {Bendi-Ouis, Yannis and Hinaut, Xavier},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.02917},
  note   = {EST: hybrid architecture combining Transformer attention with reservoir computing dynamics. Closest architectural cousin of RotMem among published work.}
}

% =====================================================================
% Theoretical foundations
% =====================================================================

@article{vla2025,
  title  = {Variational Linear Attention: Stable Associative Memory for Long-Context Transformers},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2605.11196},
  note   = {Proves (Proposition 2) that normalising write direction to unit length gives recurrence Jacobian spectral norm exactly 1 for all sequence lengths. **Direct mathematical foundation** for RotMem's V_t orthogonal-rotation guarantee.}
}

@article{long_seq_hopfield2025,
  title  = {Long Sequence {Hopfield} Memory},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2505.10906},
  note   = {Modern Hopfield networks extended to long sequences; gives a parallel-attention theoretical framework. Cited to position RotMem's orthogonal-rotation as the discrete-time analogue of an associative memory with bounded retrieval error.}
}

@article{hopfield_rnn2025,
  title  = {A Non-Markovian Route to Coherence in Heterogeneous Diffusive Systems},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2301.07608},
  note   = {Non-Markovian foundation models with memory. Cited as parallel motivation for the orthogonal-recurrence paradigm.}
}

@article{jl2020,
  title  = {Sparser {Johnson-Lindenstrauss} Transforms},
  author = {Author, et al.},
  year   = {2020},
  url    = {https://arxiv.org/abs/2009.08320},
  note   = {Random orthogonal projections approximately preserve all pairwise Euclidean distances. RotMem uses *deterministic* orthogonal projection — strictly more information-preserving than random JL.}
}

@article{loma2024,
  title  = {{LoMA}: Lossless Compressed Memory Attention},
  author = {Author, et al.},
  year   = {2024},
  url    = {https://arxiv.org/abs/2401.09486},
  note   = {Claims "lossless" KV-cache compression. We adopt LoMA's framing but qualify RotMem as *cosine-preserving* (near-lossless for retrieval, but not bit-perfect reconstruction).}
}

@article{scaffold_flow2025,
  title  = {What should we forget? A computational model of memory consolidation},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2508.11646},
  note   = {Formulates memory consolidation as scaffold-flow: fast state-dependent responses (flow) + slowly-changing physical variables (scaffold). Strength field = scaffold, lazy V_t basis = flow.}
}

@article{memfly2022,
  title  = {{MemFly}: On-the-Fly Memory Optimization via Information Bottleneck},
  author = {Author, et al.},
  year   = {2022},
  url    = {https://arxiv.org/abs/2208.10342},
  note   = {Information-bottleneck framing of memory optimisation. Cited as theoretical cousin of RotMem's information-preservation claim.}
}

% =====================================================================
% Memory-agent benchmarks and competency frameworks
% =====================================================================

@article{locobench2025,
  title  = {{LoCoBench-Agent}: An Interactive Benchmark for {LLM} Agents in Long-Context Software Engineering},
  author = {Qiu, K. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2507.05257},
  note   = {Defines four competencies for memory agents: (i) accurate retrieval, (ii) test-time learning, (iii) long-range understanding, (iv) selective forgetting. We map each to a RotMem mechanism.}
}

@article{haystackcraft2025,
  title  = {Haystack Engineering: Context Engineering for Heterogeneous and Agentic Long-Context Evaluation},
  author = {Park, J. and others},
  year   = {2025},
  url    = {https://arxiv.org/abs/2510.07414},
  note   = {Argues NIAH is too clean; introduces HaystackCraft built on Wikipedia hyperlinks with multi-hop questions. Used as our robustness extension.}
}

@article{long_horizon_mirage2025,
  title  = {The Long-Horizon Task Mirage? Diagnosing Where and Why Agentic Systems Break},
  author = {Author, et al.},
  year   = {2025},
  url    = {https://arxiv.org/abs/2502.05227},
  note   = {Argues LLM agents break down on long-horizon tasks requiring extended, interdependent action sequences. Frames RotMem's contribution: preventing the long-horizon break by maintaining a single-session memory state without cliff information loss.}
}

@article{memgym2026,
  title  = {{MemGym}: a Long-Horizon Memory Environment for {LLM} Agents},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2605.20833},
  note   = {**The benchmark for long-horizon agentic memory.** Five tracks across four regimes: tool-use dialogue ($\tau^2$-bench), deep-research (MEMGYM-DR), coding (SWE-Gym, MEMGYM-CODEQA). Replaces our custom Stage 2 CLI harness.}
}

% =====================================================================
% Closest behavioural neighbours
% =====================================================================

@article{oblivion2026,
  title  = {{Oblivion}: Self-Adaptive Agentic Memory Control through Decay-Driven Activation},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.00131},
  note   = {Closest behavioural twin: read/write decoupling + decay-based strength reweighting, but uses an LLM-based controller. RotMem = Oblivion minus the controller.}
}

@article{smartsearch2026,
  title  = {{SmartSearch}: How Ranking Beats Structure for Conversational Memory Retrieval},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.15599},
  note   = {Retrieves from raw conversation history using NER + CrossEncoder rank fusion. Oracle analysis: retrieval recall 98.6\% but only 22.5\% gold survival without intelligent ranking. RotMem = SmartSearch minus the CrossEncoder.}
}

@article{lcm2026,
  title  = {{LCM}: Lossless Context Management},
  author = {Ehrlich, Clint and Blackman, Theodore},
  year   = {2026},
  url    = {https://arxiv.org/abs/2605.04050},
  note   = {Deterministic architecture for LLM memory that outperforms Claude Code on OOLONG (32K-1M tokens). Uses *hierarchical summary DAG* (lossy) + *LLM-Map primitives* (still calls LM). **Closest competing architecture**. LCM is recursive+summary-DAG, RotMem is non-recursive+flat-orthogonal-buffer.}
}

@article{rlm2026,
  title  = {{Recursive Language Models}},
  author = {Zhang, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.02615},
  note   = {Foundation of LCM. Recursive Language Models: offload prompt to external REPL with recursion depth d. Reproduction paper finds depth-2 RLMs "overthink" — confirms our position that adding complexity does not help; deterministic rules suffice.}
}

@article{chainedrlm2026,
  title  = {Chained Recursive Language Models for Multi-Iteration Reasoning},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2608.05124},
  note   = {Same underlying model called repeatedly with compact plain-text summaries. Alternative to RotMem's flat-orthogonal-buffer design; their approach is recursive+summary, ours is non-recursive+projection.}
}

@article{napmem2026,
  title  = {From Passive Retrieval to Active Memory Navigation: Learning to Use Memory as a Structured Action Space},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2607.05794},
  note   = {Active memory navigation via tool-use — orthogonal axis to RotMem. Cites the *passive-vs-active memory* boundary; RotMem is on the passive side with deterministic top-k, NapMem is on the active side with tool-use navigation.}
}

@article{memsifter2026,
  title  = {{MemSifter}: Offloading {LLM} Memory Retrieval via Outcome-Driven Proxy Reasoning},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.03379},
  note   = {Uses a *small proxy LM* for memory retrieval. **Naming-collision risk.** RotMem = "MemSifter minus the proxy LM" — deterministic cosine rank fusion, no second model.}
}

@article{memcollusion2026,
  title  = {{MemCollusion} (Salami Attack): Stealthy Collusive Memory Poisoning against {OpenClaw}},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2608.01637},
  note   = {Salami-tactics: adversarial objective sliced across individually-benign fragments whose joint effect is harmful. RotMem's exponential decay breaks the joint effect within O(log k) turns.}
}

@article{backreveal2026,
  title  = {{Back-Reveal}: Your {LLM} Agent Can Leak Your Data via Backdoored Tool Use},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2604.05432},
  note   = {Demonstrates data exfiltration via backdoored memory-access tool calls. Cited to argue RotMem's deterministic policy has no backdoor surface.}
}

@article{agentlab_attacks2026,
  title  = {{AgentLAB}: Benchmarking {LLM} Agents against Long-Horizon Attacks},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2605.29960},
  note   = {Benchmark suite for long-horizon adversarial attacks on LLM agents with persistent memory. Used as our robustness-extension benchmark.}
}

@article{memcollab2026,
  title  = {{MemCollab}: Cross-Model Memory Collaboration via Contrastive Trajectory Distillation},
  author = {Author, et al.},
  year   = {2026},
  url    = {https://arxiv.org/abs/2603.23234},
  note   = {Single memory system shared across agents with different backbones. Cited as a use case where RotMem's *model-agnostic* V_t + cosine ranking is naturally portable.}
}

